# http://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 4

[{package.json,tsconfig.json,tsconfig.*.json,pnpm-*.yaml,components.json}]
indent_size = 2

[*.{js,ts}]
quote_style = single

[Makefile]
indent_style = tab
