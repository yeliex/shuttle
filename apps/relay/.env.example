AUTH_BASE_URL=http://localhost:8787
AUTH_PROVIDERS=email-password
AUTH_SECRET=replace-with-at-least-32-random-characters
OPEN_REGISTRATION=true
# AUTH_PROVIDER_ALLOWED_DOMAINS=example.com,team.example.com
# ADMIN_EMAILS=admin@example.com
DATABASE_URL=file:./data/shuttle.db

# Required only when GitHub is included in AUTH_PROVIDERS.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional invitation email delivery. Use 587/starttls or 465/tls on Workers.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=shuttle@example.com
# SMTP_FROM_NAME=Shuttle
